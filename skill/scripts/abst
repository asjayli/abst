#!/usr/bin/env bash
# ABST engine — Auto Business Statement Testing 的确定性判定机（shell 实现）。
# 兼容 bash >= 3.2（macOS 自带 bash 3.2.57 可运行）；依赖：jq、sha256sum、stat、date（GNU/BSD 双兼容）。
# 设计文档：docs/abst-design.md
#
# 命令：init / endorse / accept / check / verify / report / gate / doctor
#
# 原则（设计文档 §二）：注册表、状态机迁移、Gate 是确定性工具，每次必跑；
# AI 执行派生与取证，但判定权在本引擎——自报不等于事实。
set -euo pipefail
set -f # 禁用 glob：impl-refs 等路径按字面处理

VERSION="0.2.0"

# ---------- 参数 ----------
CMD="${1:-}"; shift || true
ROOT="$(pwd)"; BY=""; FILES=""; IDLIST=""; ALL=0; FORCE=0; RESULTS=""
POS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --root) ROOT="$2"; shift 2;;
    --by) BY="$2"; shift 2;;
    --files) FILES="$2"; shift 2;;
    --ids) IDLIST="$2"; shift 2;;
    --results) RESULTS="$2"; shift 2;;
    --all) ALL=1; shift;;
    --force) FORCE=1; shift;;
    *) POS+=("$1"); shift;;
  esac
done
ROOT="$(cd "$ROOT" && pwd)"
DIR="$ROOT/abst"
REGISTRY="$DIR/registry.json"
STATE="$DIR/.abst-state.json"
RESULTS="${RESULTS:-$DIR/evidence-results.json}"
REPORT="$DIR/abst-report.json"

fail() { echo "✗ $1" >&2; exit 2; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%S.000Z; }
sha_str() { printf '%s' "$1" | sha256sum | cut -d' ' -f1; }
file_hash() { if [[ -f "$ROOT/$1" ]]; then sha256sum "$ROOT/$1" | cut -d' ' -f1; else echo '<missing>'; fi }
# GNU/BSD 兼容
mtime() {
  [[ -f "$1" ]] || { echo 0; return; }
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}
date_epoch() { # ISO 8601 → epoch（统一按 UTC 解析；if 语句形式：&& 链失败会触发 set -e）
  local out
  if out="$(TZ=UTC date -d "$1" +%s 2>/dev/null)" && [[ -n "$out" ]]; then echo "$out"; return; fi
  if out="$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "${1%%.*}" +%s 2>/dev/null)" && [[ -n "$out" ]]; then echo "$out"; return; fi
  echo 0
}
endorsement_hash() { # $1=text $2=version
  sha_str "$(printf '%s\n%s' "$1" "$2")"
}

load_registry() {
  [[ -f "$REGISTRY" ]] || fail "注册表不存在：$REGISTRY（先运行 abst init）"
  cat "$REGISTRY"
}

# ---------- 注册表内存视图（索引数组，bash 3.2 兼容） ----------
REG_RAW=""
IDS=()
S_TEXT=(); S_LEVEL=(); S_FEATURE=(); S_SIGN=(); S_EXEC=(); S_WEIGHT=(); S_VER=()
S_ENDHASH=(); S_ACCHASH=(); S_VERDICT=(); S_WAIVER_EXP=(); S_CREATED=()
S_IMPL=(); S_REFINES=(); S_EVIDENCE=(); S_OFFN=()

idx_of() { # $1=id → 输出下标
  local i
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    [[ "${IDS[$i]}" == "$1" ]] && { echo "$i"; return 0; }
  done
  return 1
}

unesc() { # @tsv 反转义（\t \n \r \\），从左到右扫描；结果 → UNESC_REPLY
  local s="$1" out=""
  while [[ -n "$s" ]]; do
    case "$s" in
      '\\t'*) out+=$'\t'; s="${s:2}";;
      '\\n'*) out+=$'\n'; s="${s:2}";;
      '\\r'*) out+=$'\r'; s="${s:2}";;
      '\\\\'*) out+='\'; s="${s:2}";;
      *) out+="${s:0:1}"; s="${s:1}";;
    esac
  done
  UNESC_REPLY="$out"
}

load_state() { # 解析 registry 到索引数组（一次 jq TSV 导出，避免逐字段 fork）
  ev_cache_clear
  IDS=()
  S_TEXT=(); S_LEVEL=(); S_FEATURE=(); S_SIGN=(); S_EXEC=(); S_WEIGHT=(); S_VER=()
  S_ENDHASH=(); S_ACCHASH=(); S_VERDICT=(); S_WAIVER_EXP=(); S_CREATED=()
  S_IMPL=(); S_REFINES=(); S_EVIDENCE=(); S_OFFN=()
  local reg bad_id
  reg="$(load_registry)"
  REG_RAW="$reg"
  # id 字符集校验：id 会进入后续 jq 表达式与 JSON 拼接，限定安全字符集（同时防注入）
  bad_id="$(jq -r '.statements[] | select(.id != null and (.id | test("[^A-Za-z0-9._-]"))) | .id' <<<"$reg")"
  [[ -z "$bad_id" ]] || fail "声明 id 含非法字符（允许 [A-Za-z0-9._-]）：$bad_id"
  # impl-refs 空白 fail-fast：engine 按空白分词，含空白的路径在哈希基线 TSV 中会破坏分列
  bad_id="$(jq -r '.statements[] | select((."impl-refs" // []) | any(.[]; test("\\s"))) | .id' <<<"$reg")"
  [[ -z "$bad_id" ]] || fail "impl-refs 含空白字符（不支持，路径按空白分词）：$bad_id"
  local line id text level feature sign exec weight ver endhash acchash verdict wexp created impl refines evid offn
  # 分隔符用 US(0x1f)：tab 属 IFS 空白字符，连续 tab 会被 read 折叠吞掉空字段导致整行左移错位
  while IFS=$'\037' read -r id text level feature sign exec weight ver endhash acchash verdict wexp created impl refines evid offn; do
    [[ -n "$id" ]] || continue
    unesc "$text"; text="$UNESC_REPLY"
    unesc "$feature"; feature="$UNESC_REPLY"
    unesc "$created"; created="$UNESC_REPLY"
    unesc "$evid"; evid="$UNESC_REPLY" # evidence JSON 内的反斜杠经 @tsv 转义，须还原
    IDS+=("$id")
    S_TEXT+=("$text"); S_LEVEL+=("$level"); S_FEATURE+=("$feature"); S_SIGN+=("$sign")
    S_EXEC+=("$exec"); S_WEIGHT+=("$weight"); S_VER+=("$ver")
    S_ENDHASH+=("$endhash"); S_ACCHASH+=("$acchash"); S_VERDICT+=("$verdict")
    S_WAIVER_EXP+=("$wexp"); S_CREATED+=("$created")
    S_IMPL+=("$impl"); S_REFINES+=("$refines"); S_EVIDENCE+=("$evid"); S_OFFN+=("$offn")
  done < <(jq -r '.statements[] | [
      .id,
      (.text // ""),
      (.level // ""),
      (.feature // ""),
      (.signatory // ""),
      ((.executable // true) | tostring),
      ((.weight // 1) | tostring),
      ((.version // 1) | tostring),
      (.endorsement.hash // ""),
      (.acceptance.hash // ""),
      (.verdict // "UNPROVEN"),
      (.waiver.expires // ""),
      (."created-at" // ""),
      (."impl-refs" // [] | map(sub("^\\./"; "")) | join(" ")),
      (.refines // [] | join(" ")),
      ((.evidence // []) | tostring),
      ((.evidence // [] | map(select(.status == "official")) | length | tostring))
    ] | @tsv' <<<"$reg" | sed $'s/\t/\037/g')
  precompute
}

children_of() { # $1=parent id → 输出空格分隔的子声明 id
  local i out=""
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    case " ${S_REFINES[$i]} " in *" $1 "*) out="$out ${IDS[$i]}";; esac
  done
  echo "${out# }"
}

# ---------- 预计算（消除 ev/is_stale 递归中的重复 fork） ----------
NOW_ISO=""; S_ENDCALC=(); FILES_LIST=(); FILES_HASH=(); BASE_MAP_L=(); BASE_MAP_H=()

file_hash_of() { # $1=file → FILE_HASH_REPLY（未跟踪文件返回 <missing>/<untracked>）
  local k n=${#FILES_LIST[@]}
  for ((k = 0; k < n; k++)); do
    if [[ "${FILES_LIST[$k]}" == "$1" ]]; then FILE_HASH_REPLY="${FILES_HASH[$k]}"; return 0; fi
  done
  FILE_HASH_REPLY="<untracked>"; return 1
}

precompute() { # load_state 后调用一次：当前时间、逐声明背书 hash、impl 文件 hash、失鲜基线
  NOW_ISO="$(now_iso)"
  local i f
  S_ENDCALC=()
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    S_ENDCALC+=("$(endorsement_hash "${S_TEXT[$i]}" "${S_VER[$i]}")")
  done
  FILES_LIST=(); FILES_HASH=()
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    for f in ${S_IMPL[$i]}; do
      file_hash_of "$f" || { FILES_LIST+=("$f"); FILES_HASH+=("$(file_hash "$f")"); }
    done
  done
  BASE_MAP_L=(); BASE_MAP_H=()
  if [[ -f "$STATE" ]]; then
    while read -r f _h_ 2>/dev/null; do BASE_MAP_L+=("$f"); BASE_MAP_H+=("$_h_"); done < <(jq -r '.implHashes // {} | to_entries[] | "\(.key) \(.value)"' "$STATE")
  fi
}

is_endorsed() { # $1=下标（纯内存：与预计算 hash 比较）
  local i="$1"
  [[ -n "${S_ENDHASH[$i]}" && "${S_ENDHASH[$i]}" == "${S_ENDCALC[$i]}" ]]
}

is_stale() { # $1=下标；基线存在且 impl-refs 哈希变化 → STALE（纯内存查表）
  local i="$1" f k n=${#BASE_MAP_L[@]} bh
  [[ $n -gt 0 ]] || return 1
  for f in ${S_IMPL[$i]}; do
    bh=""
    for ((k = 0; k < n; k++)); do
      if [[ "${BASE_MAP_L[$k]}" == "$f" ]]; then bh="${BASE_MAP_H[$k]}"; break; fi
    done
    [[ -z "$bh" ]] && continue
    file_hash_of "$f"
    [[ "$bh" != "$FILE_HASH_REPLY" ]] && return 0
  done
  return 1
}

# ---------- 状态机（设计文档 §4.3，含 §4.4 goal 合取） ----------
# $1=id $2=环保护链（空格分隔）→ 结果写 EV_REPLY（无 fork）；结果按 idx 缓存于 EV_V，
# 修改 S_VERDICT 后必须 ev_cache_clear，否则缓存值过期
EV_REPLY="UNPROVEN"
EV_V=()
ev_cache_clear() { EV_V=(); }
ev() {
  local id="$1" seen=" ${2:-} " i v kv k kids n=${#IDS[@]} kk
  IDX_OF=-1
  for ((kk = 0; kk < n; kk++)); do
    [[ "${IDS[$kk]}" == "$id" ]] && { IDX_OF=$kk; break; }
  done
  if [[ $IDX_OF -lt 0 ]]; then EV_REPLY="UNPROVEN"; return; fi
  i=$IDX_OF
  case "$seen" in *" $id "*) EV_REPLY="${S_VERDICT[$i]}"; return;; esac
  if [[ -n "${EV_V[$i]:-}" ]]; then EV_REPLY="${EV_V[$i]}"; return; fi
  if ! is_endorsed "$i"; then v="DRAFT"
  elif [[ -n "${S_WAIVER_EXP[$i]}" ]]; then
    if [[ "${S_WAIVER_EXP[$i]}" < "$NOW_ISO" ]]; then v="UNPROVEN"; else v="WAIVED"; fi
  elif [[ "${S_SIGN[$i]}" == "human" ]]; then
    # 逐次验收（§4.3）：impl-refs 命中失鲜即回待验收；否则凭 acceptance（绑定 text+version）判 PROVEN
    if is_stale "$i"; then v="UNPROVEN"
    elif [[ -n "${S_ACCHASH[$i]}" && "${S_ACCHASH[$i]}" == "${S_ENDCALC[$i]}" ]]; then v="PROVEN"
    else v="UNPROVEN"; fi
  elif is_stale "$i"; then v="STALE"
  else
    kids=""
    for ((kk = 0; kk < n; kk++)); do
      case " ${S_REFINES[$kk]} " in *" $id "*) kids="$kids ${IDS[$kk]}";; esac
    done
    kids="${kids# }"
    if [[ -n "${kids// /}" ]]; then
      # goal 合取（§4.4）：自身证据判定（如有）与其全部子声明判定的合取
      # 优先级：VIOLATED > STALE > UNPROVEN > PROVEN
      v="PROVEN"
      if [[ "${S_OFFN[$i]}" != "0" ]]; then
        case "${S_VERDICT[$i]}" in
          VIOLATED) v="VIOLATED";;
          STALE) v="STALE";;
          PROVEN) ;;
          *) v="UNPROVEN";;
        esac
      fi
      if [[ "$v" != "VIOLATED" ]]; then
        for k in $kids; do
          ev "$k" "${seen# } $id"; kv="$EV_REPLY"
          case "$kv" in
            VIOLATED) v="VIOLATED"; break;;
            STALE) [[ "$v" == "PROVEN" || "$v" == "UNPROVEN" ]] && v="STALE";;
            PROVEN|WAIVED) ;;
            *) [[ "$v" == "PROVEN" ]] && v="UNPROVEN";;
          esac
        done
      fi
    else
      v="${S_VERDICT[$i]}"
    fi
  fi
  EV_REPLY="$v"; EV_V[$i]="$v"
}

reaches_endorsed_mission() { # $1=id $2=环保护链
  local id="$1" seen=" ${2:-} " i p
  case "$seen" in *" $id "*) return 1;; esac
  i="$(idx_of "$id")" || return 1
  [[ "${S_LEVEL[$i]}" == "mission" ]] && is_endorsed "$i" && return 0
  for p in ${S_REFINES[$i]}; do
    if idx_of "$p" >/dev/null 2>&1 && reaches_endorsed_mission "$p" "${seen# } $id"; then return 0; fi
  done
  return 1
}

refines_has_cycle() { # $1=起点 id $2=当前 id $3=已访问链
  local start="$1" cur="$2" seen=" $3 " i p
  case "$seen" in *" $cur "*) [[ "$cur" == "$start" ]] && return 0; return 1;; esac
  i="$(idx_of "$cur")" || return 1
  for p in ${S_REFINES[$i]}; do
    if refines_has_cycle "$start" "$p" "$seen $cur"; then return 0; fi
  done
  return 1
}

# ---------- 命令 ----------
cmd_init() {
  local dir="${POS[0]:-$DIR}"
  # 防呆：目标已有 ABST 资产即拒绝——init 落错仓库是三实践中已发生的事故形态（运行时产物误入）
  if [[ -f "$dir/registry.json" && $FORCE != 1 ]]; then
    fail "目标已存在 $dir/registry.json——拒绝在既有 ABST 资产上重复 init。确认目标目录无误、只想补齐缺失文件请加 --force（既有文件仍逐个跳过，不覆盖）"
  fi
  mkdir -p "$dir/volumes" "$dir/evidence"
  put() { # $1=相对路径 $2=内容
    if [[ -f "$dir/$1" ]]; then echo "跳过（已存在）：$dir/$1"; else printf '%s' "$2" > "$dir/$1"; echo "创建：$dir/$1"; fi
  }
  put registry.json '{
  "version": 1,
  "domains": [],
  "statements": []
}
'
  put evidence-results.json '{}
'
  put glossary.md '# 统一语言词汇表（Glossary）

> 声明 text 中的领域名词必须来自本表，按限界上下文分区（设计文档 §4.6）。

## <上下文名>

| 术语 | 定义 | 同义禁用 |
| --- | --- | --- |
'
  put volumes/mission.md '# 宗旨册（mission）

> 产品思想、战略、生存条件——少而精。每条对应注册表一条 level=mission 声明，须经人工背书。
'
  put volumes/features.md '# 功能矩阵册（feature）

> feature 清单（FDD 句式：<动作> <结果> <对象>），每个 feature 标注服务的 mission、owner、状态。

| feature | 句式表述 | 服务的 mission | owner | 状态 |
| --- | --- | --- | --- | --- |
'
  put volumes/statements.md '# 声明册（goal / behavior / contract）

> 按业务域/限界上下文分章。每条声明显式三节：应然陈述 / 边界 / 弹性（设计文档 §12.3）。
'
  put evidence/README.md '# e2e 证据卷宗（evidence form=e2e 的 resultsFile 指向此处）

契约：顶层 JSON 对象，`"pass"` 布尔必填（engine 回读唯一判据）；`"at"`（ISO 8601）与 `"note"`（复证叙述：做了什么、改了什么、证据链如何闭合）可选但推荐。

`volumes/` 专属意图四册（人读资产，§12.2）；本目录专属机器回读卷宗——两者不得混放。
'
  echo
  echo "目录语义：volumes/ = 意图四册（人读）；evidence/ = e2e 证据卷宗（机器回读）。"
  echo "下一步：AI 派生声明草案入 registry.json（DRAFT），人工逐条背书（abst endorse）后再启动取证。"
}

cmd_endorse() {
  [[ -n "$BY" ]] || fail "缺少 --by <背书人>——背书必须落实到具体的人"
  load_state
  local ids="" id i uniq="" todo="" pairs="[]"
  if [[ -n "$IDLIST" ]]; then
    local old_ifs="$IFS"; IFS=','
    for id in $IDLIST; do ids="$ids $id"; done
    IFS="$old_ifs"
    ids="${ids# }"
  elif [[ -n "${POS[0]:-}" ]]; then
    ids="${POS[0]}"
  fi
  [[ -n "$ids" ]] || fail "缺少声明 id（单条：abst endorse <id>；批量：abst endorse --ids a,b,c）"
  for id in $ids; do case " $uniq " in *" $id "*) ;; *) uniq="$uniq $id";; esac; done
  # 事务性预校验：任一 id 不存在则整批拒绝；逐条输出清单供人过目（§12.1：批量是执行效率，逐条审查仍是人工职责）
  for id in $uniq; do
    i="$(idx_of "$id")" || fail "声明不存在：$id（整批拒绝，未写入任何背书）"
    if is_endorsed "$i"; then
      echo "○ $id 背书仍然有效，跳过"
    else
      todo="$todo $id"
      pairs="$(jq -c --arg id "$id" --arg h "$(endorsement_hash "${S_TEXT[$i]}" "${S_VER[$i]}")" '. + [{id: $id, hash: $h}]' <<<"$pairs")"
      echo "  - $id：${S_TEXT[$i]}"
    fi
  done
  todo="${todo# }"
  [[ -n "$todo" ]] || { echo "全部背书仍然有效，无需操作。"; return 0; }
  echo "以上 $(printf '%s\n' $todo | wc -l | tr -d ' ') 条待背书，背书人：$BY"
  local tmp; tmp="$(mktemp "$REGISTRY.XXXXXX")"
  trap 'rm -f "$tmp" 2>/dev/null' EXIT
  jq --argjson pairs "$pairs" --arg by "$BY" --arg at "$(now_iso)" '
    reduce $pairs[] as $p (.;
      (.statements[] | select(.id == $p.id)) |= (. + {endorsement: {hash: $p.hash, by: $by, at: $at}, verdict: "UNPROVEN"})
    )' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
  trap - EXIT
  for id in $todo; do echo "✓ $id 已背书（DRAFT → UNPROVEN）"; done
  echo "  背书绑定 text+version 的 hash——语义升版即失效，须重新背书（§4.3）。"
}

cmd_accept() {
  [[ -n "$BY" ]] || fail "缺少 --by <签署人>"
  load_state
  local ids="" id i v f tmp pairs="[]" todo="" draft_hit=0
  if [[ -n "$FILES" ]]; then
    [[ -z "$IDLIST" && -z "${POS[0]:-}" ]] || fail "--files 与 <id>/--ids 不可混用"
    FILES="$(printf '%s' "$FILES" | sed 's/\(^\|,\)\.\//\1/g')"
    # 按 Δ 列待签清单：impl-refs 命中的 human 声明中，当前判定为 UNPROVEN（含验收失效）者
    for ((i = 0; i < ${#IDS[@]}; i++)); do
      [[ "${S_SIGN[$i]}" == "human" ]] || continue
      local hit=0
      for f in ${S_IMPL[$i]}; do case ",$FILES," in *",$f,"*) hit=1; break;; esac; done
      [[ $hit == 1 ]] || continue
      ev "${IDS[$i]}" ""; v="$EV_REPLY"
      if [[ "$v" == "DRAFT" ]]; then draft_hit=$((draft_hit+1))
      elif [[ "$v" == "UNPROVEN" ]]; then ids="$ids ${IDS[$i]}"
      fi
    done
    ids="${ids# }"
    [[ $draft_hit -gt 0 ]] && echo "▲ 注意：本次 Δ 另命中 $draft_hit 条 DRAFT human 声明——未背书不可签署，先 abst endorse"
    if [[ -z "$ids" ]]; then echo "○ 本次 Δ 未命中待验收签署的 human 声明（无操作）"; return 0; fi
    echo "本次 Δ 命中待验收签署（逐次验收，§4.3）："
  elif [[ -n "$IDLIST" ]]; then
    local old_ifs="$IFS"; IFS=','
    for id in $IDLIST; do ids="$ids $id"; done
    IFS="$old_ifs"
    ids="${ids# }"
  elif [[ -n "${POS[0]:-}" ]]; then
    ids="${POS[0]}"
  fi
  [[ -n "$ids" ]] || fail "缺少声明 id（单条：abst accept <id>；批量：--ids a,b,c；按变更：--files a,b）"
  local uniq=""
  for id in $ids; do case " $uniq " in *" $id "*) ;; *) uniq="$uniq $id";; esac; done
  for id in $uniq; do
    i="$(idx_of "$id")" || fail "声明不存在：$id（整批拒绝，未写入任何签署）"
    [[ "${S_SIGN[$i]}" == "human" ]] || fail "$id 的 signatory=${S_SIGN[$i]}，验收签署仅适用于 signatory=human 的声明"
    is_endorsed "$i" || fail "$id 尚未完成入库背书（DRAFT），先执行 abst endorse"
    todo="$todo $id"
    pairs="$(jq -c --arg id "$id" --arg h "$(endorsement_hash "${S_TEXT[$i]}" "${S_VER[$i]}")" '. + [{id: $id, hash: $h}]' <<<"$pairs")"
    echo "  - $id：${S_TEXT[$i]}"
  done
  todo="${todo# }"
  echo "以上 $(printf '%s\n' $todo | wc -l | tr -d ' ') 条验收签署，签署人：$BY"
  tmp="$(mktemp "$REGISTRY.XXXXXX")"
  trap 'rm -f "$tmp" 2>/dev/null' EXIT
  jq --argjson pairs "$pairs" --arg by "$BY" --arg at "$(now_iso)" '
    reduce $pairs[] as $p (.;
      (.statements[] | select(.id == $p.id)) |= (. + {acceptance: {hash: $p.hash, by: $by, at: $at}})
    )' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
  trap - EXIT
  for id in $todo; do echo "✓ $id 验收签署完成（PROVEN，与本次交付绑定）"; done
}

check_integrity() { # 输出错误行，返回错误数
  local errors=0 i id p official dup vv
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    id="${IDS[$i]}"
    if ! is_endorsed "$i"; then
      official="$(jq '[.[] | select(.status == "official")] | length' <<<"${S_EVIDENCE[$i]}")"
      if [[ "$official" != "0" ]]; then
        echo "✗ $id：DRAFT 声明存在正式 Evidence（背书完成前证据不得转正）"; errors=$((errors+1))
      fi
    fi
    if [[ "${S_EXEC[$i]}" == "false" && "${S_SIGN[$i]}" != "human" && -z "${S_WAIVER_EXP[$i]}" ]]; then
      echo "✗ $id：executable=false 且 signatory=auto，必须登记 waiver"; errors=$((errors+1))
    fi
    if [[ -n "${S_WAIVER_EXP[$i]}" && "${S_WAIVER_EXP[$i]}" < "$(now_iso)" ]]; then
      echo "✗ $id：waiver 已超期（${S_WAIVER_EXP[$i]}），须重新豁免或重新取证"; errors=$((errors+1))
    fi
    vv="${S_VERDICT[$i]}"
    case "$vv" in
      UNPROVEN|PROVEN|VIOLATED|STALE|WAIVED|DELEGATED|DRAFT) ;;
      *) echo "✗ $id：非法 verdict 值 $vv"; errors=$((errors+1));;
    esac
    for p in ${S_REFINES[$i]}; do
      if ! idx_of "$p" >/dev/null 2>&1; then echo "✗ $id：refines 指向不存在的声明 $p"; errors=$((errors+1)); fi
    done
    if refines_has_cycle "$id" "$id" ""; then
      echo "✗ $id：refines 成环"; errors=$((errors+1))
    fi
    if is_endorsed "$i" && [[ "${S_LEVEL[$i]}" == "goal" ]] && ! reaches_endorsed_mission "$id" ""; then
      echo "✗ $id：孤儿声明——refines 链未抵达任何已背书 mission"; errors=$((errors+1))
    fi
  done
  # waiver 三元组完整性
  local bad_waiver
  bad_waiver="$(jq -r '.statements[] | select(.waiver != null) | select((.waiver.reason // "") == "" or (.waiver.by // "") == "" or (.waiver.expires // "") == "") | .id' "$REGISTRY")"
  for p in $bad_waiver; do echo "✗ $p：waiver 三元组不完整（理由/到期时间/签署人）"; errors=$((errors+1)); done
  # evidence 形态校验：form 枚举 + 各形态必填字段
  local bad_ev
  bad_ev="$(jq -r '.statements[] | .id as $id | (.evidence // [])[]
    | select(.form != "probe" and .form != "static" and .form != "unit" and .form != "e2e")
    | "\($id)：非法 evidence form \(.form)"' "$REGISTRY")"
  for p in $bad_ev; do echo "✗ $p"; errors=$((errors+1)); done
  bad_ev="$(jq -r '.statements[] | .id as $id | (.evidence // [])[]
    | select((.form == "static" and ((.file // "") == "" or (.anchor // "") == ""))
        or (.form == "unit" and ((.file // "") == "" or (.marker // "") == ""))
        or (.form == "e2e" and (.resultsFile // "") == "")
        or (.form == "probe" and (.id // "") == ""))
    | "\($id)：evidence \(.id // .form) 必填字段缺失（static=file+anchor / unit=file+marker / e2e=resultsFile / probe=id）"' "$REGISTRY")"
  for p in $bad_ev; do echo "✗ $p"; errors=$((errors+1)); done
  # impl-refs 不得含空白（engine 按空白分词）
  local bad_ref
  bad_ref="$(jq -r '.statements[] | .id as $id | (."impl-refs" // [])[] | select(test("\\s")) | "\($id)：impl-refs 含空白字符，不被支持"' "$REGISTRY")"
  for p in $bad_ref; do echo "✗ $p"; errors=$((errors+1)); done
  dup="$(printf '%s\n' ${IDS[@]+"${IDS[@]}"} | sort | uniq -d)"
  for p in $dup; do echo "✗ $p：id 重复"; errors=$((errors+1)); done
  return $errors
}

cmd_check() {
  load_state
  local out
  if out="$(check_integrity)"; then echo "✓ 完整性检查通过"; return 0; fi
  echo "$out"
  return 1
}

cmd_verify() {
  load_state
  local fresh_after=0
  if [[ -f "$STATE" ]]; then
    fresh_after=$(date_epoch "$(jq -r '.updatedAt // "1970-01-01T00:00:00.000Z"' "$STATE")")
  fi
  # 阶段一：一次 jq 导出全部正式证据行，逐行评估（结果按声明 id 聚合为 失败集/未决集）
  local EVF_FALSE=" " EVF_NULL=" " id2 form eid efile eanchor emarker erf out st2 p2 rf2 key2
  while IFS=$'\037' read -r id2 form eid efile eanchor emarker erf; do
    [[ -n "$id2" ]] || continue
    unesc "$efile"; efile="$UNESC_REPLY"
    unesc "$eanchor"; eanchor="$UNESC_REPLY"
    unesc "$emarker"; emarker="$UNESC_REPLY"
    out=null
    case "$form" in
      probe)
        if [[ $(mtime "$RESULTS") -ge $fresh_after ]]; then # 同秒视为新：秒级 mtime 下严格大于会误杀同秒复跑的证据
          st2="$(jq -r --arg e "$eid" '.[$e].status // empty' "$RESULTS" 2>/dev/null || true)"
          if [[ "$st2" == "pass" ]]; then out=true
          elif [[ -n "$st2" ]]; then out=false
          fi
        fi;;
      static|unit)
        if [[ "$form" == "static" ]]; then key2="$eanchor"; else key2="$emarker"; fi
        if [[ -f "$ROOT/$efile" ]] && grep -qF -- "$key2" "$ROOT/$efile"; then out=true; else out=false; fi;;
      e2e)
        unesc "$erf"; rf2="$UNESC_REPLY"
        if [[ $(mtime "$ROOT/$rf2") -ge $fresh_after ]]; then
          p2="$(jq -r '.pass // empty' "$ROOT/$rf2" 2>/dev/null || true)"
          if [[ "$p2" == "true" ]]; then out=true
          elif [[ "$p2" == "false" ]]; then out=false
          fi
        fi;;
    esac
    case "$out" in
      false) EVF_FALSE="$EVF_FALSE$id2 ";;
      null) EVF_NULL="$EVF_NULL$id2 ";;
    esac
  done < <(jq -r '.statements[] | .id as $id | (.evidence // [])[] | select(.status == "official")
      | [$id, (.form // ""), (.id // ""), (.file // ""), (.anchor // ""), (.marker // ""), (.resultsFile // "")] | @tsv' <<<"$REG_RAW" | sed $'s/\t/\037/g')
  # 阶段二：主循环刷新判定（S_VERDICT 修改后清 ev 缓存）
  local STALE_SET=" " ACCEPT_CLEAR="" i id before after f
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    id="${IDS[$i]}"
    ev "$id" ""; before="$EV_REPLY"
    # 实现变更命中 DRAFT 声明：状态不变但必须告警——实现先于背书是应然滞后的危险信号（§4.3）
    if [[ "$before" == "DRAFT" ]] && is_stale "$i"; then
      echo "▲ $id 实现变更命中 DRAFT 声明——实现先于背书，应然滞后告警（§4.3）"
    fi
    if [[ "$before" != "DRAFT" && "$before" != "WAIVED" && "${S_SIGN[$i]}" != "human" ]] && [[ "${S_OFFN[$i]}" != "0" ]]; then
      if [[ "$EVF_FALSE" == *" $id "* ]]; then
        S_VERDICT[$i]="VIOLATED"; ev_cache_clear
      elif [[ "$EVF_NULL" != *" $id "* ]]; then
        S_VERDICT[$i]="PROVEN"; ev_cache_clear
      elif [[ "$before" == "STALE" || "${S_VERDICT[$i]}" == "STALE" ]]; then
        S_VERDICT[$i]="STALE"; ev_cache_clear # 证据未复跑，维持失效
      fi
    elif [[ "$before" == "STALE" && "${S_OFFN[$i]}" == "0" ]]; then
      S_VERDICT[$i]="STALE" # 无正式证据可复跑，STALE 持久化
    fi
    # 逐次验收（§4.3）：human 声明被实现变更命中 → 验收签署失效，需重新签署
    if [[ "${S_SIGN[$i]}" == "human" && "$before" != "DRAFT" && "$before" != "WAIVED" ]] && is_stale "$i"; then
      if [[ -n "${S_ACCHASH[$i]}" ]]; then
        ACCEPT_CLEAR="$ACCEPT_CLEAR $id"
        echo "◌ $id 实现变更命中 → 验收签署失效，需重新验收签署（§4.3 逐次验收）"
      fi
    fi
    ev "$id" ""; after="$EV_REPLY"
    [[ "${S_VERDICT[$i]}" == "STALE" ]] && STALE_SET="$STALE_SET$id "
    [[ "$after" == "STALE" && "${S_VERDICT[$i]}" == "STALE" ]] && echo "◌ $id 实现变更（impl-refs 命中）→ STALE，需重新取证"
    [[ "$before" != "DRAFT" && "$after" == "DRAFT" ]] && echo "◌ $id 声明语义升版 → DRAFT，需重新背书"
  done
  # 更新新鲜度基线：STALE 声明的 impl-refs 不更新——失鲜保持可见，直至证据真正复跑。
  # 必须先推进基线再写回 verdict，否则已复证的声明会以旧基线重算为 STALE 并存盘（永久锁死）
  local base_hash="{}" lines=""
  [[ -f "$STATE" ]] && base_hash="$(jq -c '.implHashes // {}' "$STATE")"
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    case "$STALE_SET" in *" ${IDS[$i]} "*) continue;; esac
    for f in ${S_IMPL[$i]}; do
      file_hash_of "$f"
      lines+="$f"$'\t'"$FILE_HASH_REPLY"$'\n'
    done
  done
  local hashes
  hashes="$(printf '%s' "$lines" | jq -Rn --argjson base "$base_hash" '
    reduce (inputs | split("\t")) as $r ($base;
      if ($r | length) == 2 then . + {($r[0]): $r[1]} else . end)')"
  local stmp; stmp="$(mktemp "$STATE.XXXXXX")"
  trap 'rm -f "$stmp" 2>/dev/null' EXIT
  jq -n --argjson h "$hashes" --arg at "$(now_iso)" '{implHashes: $h, updatedAt: $at}' > "$stmp" && mv "$stmp" "$STATE"
  trap - EXIT
  # 刷新内存基线（与刚写盘的 STATE 同步）：最终重算须以新基线判 is_stale，
  # 否则已复证声明会以旧基线重算回 STALE 并写回（原实现依赖重读 STATE 文件达到同效）
  BASE_MAP_L=(); BASE_MAP_H=()
  while read -r f _h_ 2>/dev/null; do BASE_MAP_L+=("$f"); BASE_MAP_H+=("$_h_"); done < <(jq -r '.implHashes // {} | to_entries[] | "\(.key) \(.value)"' "$STATE")
  ev_cache_clear
  # 最终判定统一以 ev() 重算值写回（合取节点不残留过期存储值）
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    ev "${IDS[$i]}" ""; S_VERDICT[$i]="$EV_REPLY"
  done
  # 写回 verdicts（并清除失效的验收签署）：id 已校验字符集、verdict 为枚举，单次 jq 合并完成
  local varr="[" sep="" aarr="" tmp
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    varr+="$sep{\"id\":\"${IDS[$i]}\",\"verdict\":\"${S_VERDICT[$i]}\"}"; sep=", "
  done
  varr+="]"
  tmp="$(mktemp "$REGISTRY.XXXXXX")"
  trap 'rm -f "$tmp" 2>/dev/null' EXIT
  if [[ -n "${ACCEPT_CLEAR// /}" ]]; then
    aarr="["; sep=""
    for id in $ACCEPT_CLEAR; do aarr+="$sep\"$id\""; sep=", "; done
    aarr+="]"
    jq --argjson vs "$varr" --argjson ac "$aarr" '
      reduce $vs[] as $x (.; (.statements[] | select(.id == $x.id)).verdict = $x.verdict)
      | reduce $ac[] as $c (.; (.statements[] | select(.id == $c)) |= del(.acceptance))
    ' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
  else
    jq --argjson vs "$varr" '
      reduce $vs[] as $x (.; (.statements[] | select(.id == $x.id)).verdict = $x.verdict)
    ' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
  fi
  trap - EXIT
  write_report
  echo "✓ 判定刷新完成（${#IDS[@]} 条声明），报告已写入 $REPORT"
  cmd_report
}

calc_metrics() { # 输出 key=value 行；依赖 load_state
  local i id v total=0 endorsed=0 req_w=0 prov_w=0 waiver_n=0
  local stale="" violated="" orphans="" draft_ids=""
  local V_ARR=()
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    ev "${IDS[$i]}" ""; V_ARR+=("$EV_REPLY")
  done
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    id="${IDS[$i]}"
    v="${V_ARR[$i]}"
    total=$((total+1))
    case "$v" in
      DRAFT) draft_ids="$draft_ids $id";;
      WAIVED) endorsed=$((endorsed+1));;
      *)
        endorsed=$((endorsed+1))
        req_w=$((req_w + ${S_WEIGHT[$i]}))
        [[ "$v" == "PROVEN" ]] && prov_w=$((prov_w + ${S_WEIGHT[$i]}))
        [[ "$v" == "STALE" ]] && stale="$stale $id"
        [[ "$v" == "VIOLATED" ]] && violated="$violated $id"
        ;;
    esac
    if [[ -n "${S_WAIVER_EXP[$i]}" ]]; then
      waiver_n=$((waiver_n+1))
    fi
    if [[ "$v" != "DRAFT" && "${S_LEVEL[$i]}" == "goal" ]] && ! reaches_endorsed_mission "$id" ""; then
      orphans="$orphans $id"
    fi
  done
  local cg="0.0" appr="0.0"
  [[ $req_w -gt 0 ]] && cg="$(awk "BEGIN{printf \"%.1f\", $prov_w * 100 / $req_w}")"
  [[ $total -gt 0 ]] && appr="$(awk "BEGIN{printf \"%.1f\", $endorsed * 100 / $total}")"
  echo "C(G)=${cg}%（${prov_w}/${req_w} 权重）"
  echo "应然批准率=${appr}%（${endorsed}/${total}）"
  # 背书积压 + 平均滞留
  local draft_n=0 age_sum=0 d now_epoch c_epoch
  now_epoch=$(date +%s)
  for d in $draft_ids; do
    draft_n=$((draft_n+1))
    c_epoch=$(date_epoch "${S_CREATED[$(idx_of "$d")]:-$(now_iso)}")
    age_sum=$((age_sum + now_epoch - c_epoch))
  done
  if [[ $draft_n -gt 0 ]]; then
    echo "背书积压=${draft_n} 条，平均滞留 $(awk "BEGIN{printf \"%.1f\", $age_sum / $draft_n / 86400}") 天"
  else
    echo "背书积压=0 条"
  fi
  # 豁免（含超期）
  local waiver_exp=""
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    [[ -n "${S_WAIVER_EXP[$i]}" && "${S_WAIVER_EXP[$i]}" < "$(now_iso)" ]] && waiver_exp="$waiver_exp ${IDS[$i]}"
  done
  # 域登记率
  local domains d_total=0 d_reg=0 d2 hit j
  domains="$(jq -r '.domains // [] | .[]' "$REGISTRY" 2>/dev/null || true)"
  if [[ -n "$domains" ]]; then
    while read -r d2; do
      [[ -z "$d2" ]] && continue
      d_total=$((d_total+1)); hit=0
      for ((j = 0; j < ${#IDS[@]}; j++)); do
        [[ "${S_FEATURE[$j]}" == "$d2" ]] && { hit=1; break; }
      done
      [[ $hit == 1 ]] && d_reg=$((d_reg+1))
    done <<<"$domains"
    echo "域登记率=${d_reg}/${d_total}"
  else
    echo "域登记率=未配置 domains"
  fi
  if [[ -n "${stale# }" ]]; then echo "判定新鲜度=$(echo $stale | wc -w | tr -d ' ') 条 STALE：${stale# }"; else echo "判定新鲜度=无 STALE"; fi
  if [[ -n "${violated# }" ]]; then echo "违反=${violated# }"; else echo "违反=0 VIOLATED"; fi
  if [[ -n "${waiver_exp# }" ]]; then echo "豁免=${waiver_n} 条，其中 $(echo $waiver_exp | wc -w | tr -d ' ') 条已超期：${waiver_exp# }"; else echo "豁免=${waiver_n} 条"; fi
  if [[ -n "${orphans# }" ]]; then echo "孤儿声明=${orphans# }"; else echo "孤儿声明=无"; fi
  # 切片（复用单次求值结果 V_ARR）
  local dim line keys k kw kp key
  for dim in level feature; do
    line=""
    keys="$(for ((i = 0; i < ${#IDS[@]}; i++)); do
      v="${V_ARR[$i]}"
      [[ "$v" != "DRAFT" && "$v" != "WAIVED" ]] || continue
      if [[ "$dim" == "level" ]]; then echo "${S_LEVEL[$i]}"; else echo "${S_FEATURE[$i]:-<none>}"; fi
    done | sort -u)"
    while read -r k; do
      [[ -z "$k" ]] && continue
      kw=0; kp=0
      for ((i = 0; i < ${#IDS[@]}; i++)); do
        v="${V_ARR[$i]}"
        [[ "$v" != "DRAFT" && "$v" != "WAIVED" ]] || continue
        if [[ "$dim" == "level" ]]; then key="${S_LEVEL[$i]}"; else key="${S_FEATURE[$i]:-<none>}"; fi
        [[ "$key" == "$k" ]] || continue
        kw=$((kw + ${S_WEIGHT[$i]}))
        [[ "$v" == "PROVEN" ]] && kp=$((kp + ${S_WEIGHT[$i]}))
      done
      line="${line}${k}: $(awk "BEGIN{printf \"%.1f\", $kp * 100 / $kw}")%；"
    done <<<"$keys"
    if [[ "$dim" == "level" ]]; then echo "按 level=${line%；}"; else echo "按 feature=${line%；}"; fi
  done
}

write_report() {
  local stmts="[" sep="" i metrics_json="{}" line m
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    ev "${IDS[$i]}" ""
    stmts+="$sep{\"id\":\"${IDS[$i]}\",\"verdict\":\"$EV_REPLY\"}"; sep=", "
  done
  stmts+="]"
  m="$(calc_metrics)"
  while read -r line; do
    [[ -z "$line" ]] && continue
    metrics_json="$(jq -c --arg k "${line%%=*}" --arg v "${line#*=}" '. + {($k): $v}' <<<"$metrics_json")"
  done <<<"$m"
  local rtmp; rtmp="$(mktemp "$REPORT.XXXXXX")"
  trap 'rm -f "$rtmp" 2>/dev/null' EXIT
  jq -n --arg at "$(now_iso)" --argjson m "$metrics_json" --argjson s "$stmts" \
    '{generatedAt: $at, metrics: $m, statements: $s}' > "$rtmp" && mv "$rtmp" "$REPORT"
  trap - EXIT
}

cmd_report() {
  load_state
  # C(G) 禁止单独展示——强制与应然批准率、背书积压成对输出（§七）
  calc_metrics | while read -r line; do
    [[ -n "$line" ]] && echo "${line%%=*}：${line#*=}"
  done
}

cmd_gate() {
  load_state
  [[ $ALL == 1 || -n "$FILES" ]] || fail "缺少 --files a,b,c 或 --all"
  # --files 规范化：去 ./ 前缀（与 load_state 对 impl-refs 的规范化同口径）
  FILES="$(printf '%s' "$FILES" | sed 's/\(^\|,\)\.\//\1/g')"
  # S(Δ)：impl-refs 命中的声明 + refines 双向闭包（§六）
  local IN_S=" " i id f p changed
  for ((i = 0; i < ${#IDS[@]}; i++)); do
    if [[ $ALL == 1 ]]; then IN_S="$IN_S${IDS[$i]} "; continue; fi
    for f in ${S_IMPL[$i]}; do
      case ",$FILES," in *",$f,"*) IN_S="$IN_S${IDS[$i]} "; break;; esac
    done
  done
  # 白名单制：--files 未命中任何声明 → S(Δ) 无法界定 → 默认拒绝（§六）
  if [[ $ALL != 1 && "$IN_S" == " " ]]; then
    echo "✗ 转人工：--files 未命中任何声明的 impl-refs，S(Δ) 为空——无法界定即默认拒绝（§六白名单制）"
    return 1
  fi
  # 闭包扩展（向上 refines + 向下 children）
  changed=1
  while [[ $changed == 1 ]]; do
    changed=0
    for id in $IN_S; do
      i="$(idx_of "$id")" || fail "声明 $id 不在注册表中（注册表损坏？先运行 abst check）"
      for p in ${S_REFINES[$i]} $(children_of "$id"); do
        case "$IN_S" in *" $p "*) ;; *) IN_S="$IN_S$p "; changed=1;; esac
      done
    done
  done
  local reasons="" n=0 v
  for id in $IN_S; do
    n=$((n+1))
    i="$(idx_of "$id")" || fail "声明 $id 不在注册表中（注册表损坏？先运行 abst check）"
    ev "$id" ""; v="$EV_REPLY"
    case "$v" in
      DRAFT) reasons="$reasons$id：DRAFT（未背书应然不支持放行）\n";;
      STALE) reasons="$reasons$id：STALE（证据失鲜，需重新取证）\n";;
      VIOLATED) reasons="$reasons$id：VIOLATED（三叉定位：实现错/声明错/证据错，§九）\n";;
      DELEGATED) reasons="$reasons$id：DELEGATED（委托未经回读确认——先运行 abst verify）\n";;
      UNPROVEN)
        if [[ "${S_SIGN[$i]}" == "human" ]]; then reasons="$reasons$id：UNPROVEN（待本次验收签署）\n"
        else reasons="$reasons$id：UNPROVEN（无有效证据）\n"; fi;;
      PROVEN|WAIVED)
        if [[ "${S_LEVEL[$i]}" == "goal" ]] && ! reaches_endorsed_mission "$id" ""; then
          reasons="$reasons$id：孤儿声明\n"
        fi;;
      *) reasons="$reasons$id：未知判定 $v（fail-closed 转人工）\n";;
    esac
  done
  local nreasons; nreasons="$(printf '%b' "$reasons" | grep -c . || true)"
  if [[ "$nreasons" == "0" ]]; then
    echo "✓ Gate 放行（S(Δ) 共 $n 条声明，全部 PROVEN/WAIVED）"
    echo "  前提：技术层验证（UT/IT/E2E/静态检查）全绿——本引擎不消费该信号，由 CI 合取。"
    return 0
  fi
  echo "✗ 转人工（S(Δ) 共 $n 条声明，$nreasons 项未了）："
  printf '%b' "$reasons" | while read -r line; do [[ -n "$line" ]] && echo "  - $line"; done
  return 1
}

cmd_doctor() {
  load_state
  echo "── 完整性 ──"
  local rc=0 out
  out="$(check_integrity)" || rc=$?
  if [[ $rc == 0 ]]; then echo "✓ 无完整性错误"; else echo "$out"; fi
  echo "── 健康度（§七）──"
  calc_metrics | while read -r line; do
    [[ -n "$line" ]] && echo "${line%%=*}：${line#*=}"
  done
  [[ $rc != 0 ]] && return 1
  return 0
}

usage() {
  cat <<EOF
ABST engine $VERSION — 用法：
  abst init [dir] [--force]  初始化 ABST 资产（独立顶层目录；已有 registry.json 时拒绝，--force 仅补缺失文件）
  abst endorse <id|--ids a,b,c> --by 人
                             入库背书（DRAFT → UNPROVEN 的唯一通道；批量先输出逐条清单）
  abst accept <id|--ids a,b,c|--files Δ> --by 人
                             signatory=human 声明的验收签署；--files 按本次变更列待签清单一批签署
  abst check                 完整性检查
  abst verify                消费证据结果，刷新判定与 STALE 基线
  abst report                C(G) + 批准率 + 积压（强制成对输出）
  abst gate --files a,b      放行判定（--all 表示全库）
  abst doctor                体检：完整性 + 健康度
通用参数：--root <仓库根>（默认 cwd）、--results <证据结果文件>
兼容 bash >= 3.2，依赖 jq + coreutils（GNU/BSD 均可）。
EOF
}

case "$CMD" in
  init) cmd_init;;
  endorse) cmd_endorse;;
  accept) cmd_accept;;
  check) cmd_check;;
  verify) cmd_verify;;
  report) cmd_report;;
  gate) cmd_gate;;
  doctor) cmd_doctor;;
  --version|version) echo "abst $VERSION";;
  help|--help|"") usage;;
  *) usage; exit 2;;
esac
